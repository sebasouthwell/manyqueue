# Spotify app (create at https://developer.spotify.com/dashboard)
# Redirect URI must be exactly: http://127.0.0.1:3000/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional BACKUP app, created on a SECOND Spotify developer account (quota is per developer
# account, so a second app on the same account doesn't help). Same redirect URI as above, and the
# hosting Spotify account must be added under "User Management" in the backup app's dashboard.
# When the main app is rate-limited, ManyQueue switches to this one. Log in through it once via
# the link on the host page (or /auth/login?slot=backup).
BACKUP_CLIENT_ID=
BACKUP_SECRET_ID=
# Must match the redirect URI registered in the Spotify dashboard exactly.
AUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_KEY=

# Random string used to sign cookies. Generate the same way as TOKEN_KEY.
COOKIE_SECRET=

# The URL phones on the same Wi-Fi will use to reach this laptop.
# Find your LAN IP with `ip addr` / `ifconfig`.
# On WSL2: the default NAT'd WSL IP is NOT reachable from phones. Fix by enabling
# mirrored networking — add to %USERPROFILE%\.wslconfig on Windows:
#   [wsl2]
#   networkingMode=mirrored
# then run `wsl --shutdown` from Windows and reopen WSL. After that, `ip addr`
# inside WSL shows the real LAN IP(s) directly.
PUBLIC_URL=http://<LAN-IP>:3000

PORT=3000
NODE_ENV=development
# Optional: absolute path override for the SQLite file. Defaults to <repo>/data/manyqueue.db
# DB_PATH=/absolute/path/to/manyqueue.db
# Optional: how many proxies sit in front of the server (a reverse proxy or tunnel), so guests' real
# IPs are seen. Default 2.
# TRUST_PROXY_HOPS=2

# Optional: AI party nicknames and genre tags, through Claude (Anthropic) or DeepSeek. Set either key:
# with both, Claude is used unless AI_PROVIDER says otherwise; with neither, the AI features switch
# themselves off and everything else works. Only anonymous music data is ever sent.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_API_KEY=
# AI_PROVIDER=anthropic   # or deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
