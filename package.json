{
  "name": "manyqueue",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"pnpm --filter @manyqueue/web dev\" \"pnpm --filter @manyqueue/server dev\"",
    "build": "pnpm --filter @manyqueue/shared build && pnpm --filter @manyqueue/web build && pnpm --filter @manyqueue/server build",
    "db:generate": "pnpm --filter @manyqueue/server db:generate",
    "db:migrate": "pnpm --filter @manyqueue/server db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
